generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String
  psnId         String?  @unique
  psnVerifyCode String?
  user          User?    @relation(fields: [psnId], references: [psnId])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([username])
  @@index([email])
}
model User {
  psnId     String      @id
  username  String
  avatarUrl String?
  stats     UserStats?
  trophies  UserTrophy[]
  games     UserGame[]
  account   Account?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([username])
}

model UserStats {
  psnId    String @id
  user     User   @relation(fields: [psnId], references: [psnId])
  level    Int    @default(0)
  progress Int    @default(0)
  bronze   Int    @default(0)
  silver   Int    @default(0)
  gold     Int    @default(0)
  platinum Int    @default(0)
}

model Game {
  id              String        @id
  title           String
  platform        String?
  iconUrl         String?
  trophySetVersion String?
  trophies        Trophy[]
  trophyGroups    TrophyGroup[]
  users           UserGame[]

  @@index([title])
}

model TrophyGroup {
  gameId   String
  groupId  String    // identifiant PSN
  game     Game      @relation(fields: [gameId], references: [id])
  name     String
  iconUrl  String?
  trophies Trophy[]

  @@id([gameId, groupId])
}

model Trophy {
  gameId      String
  trophyId    Int             // identifiant PSN
  groupId     String
  game        Game            @relation(fields: [gameId], references: [id])
  trophyGroup TrophyGroup     @relation(fields: [gameId, groupId], references: [gameId, groupId])
  name        String
  description String?
  type        TrophyType      // la rareté du trophée (bronze/argent/or/platine)
  rareness    TrophyRareness? // le palier de rareté calculé par PSN
  earnedRate  Float?          // le % d'obtention du trophée
  hidden      Boolean         @default(false) // trophée masqué ou non
  iconUrl     String?
  users       UserTrophy[]

  @@id([gameId, trophyId])
}

model UserGame {
  userId              String
  gameId              String
  lastUpdatedDateTime DateTime?
  user                User      @relation(fields: [userId], references: [psnId])
  game                Game      @relation(fields: [gameId], references: [id])

  @@id([userId, gameId])
  @@index([userId])
}

model UserTrophy {
  userId   String
  gameId   String
  trophyId Int
  earnedAt DateTime?
  user     User      @relation(fields: [userId], references: [psnId])
  trophy   Trophy    @relation(fields: [gameId, trophyId], references: [gameId, trophyId])


  @@id([userId, gameId, trophyId])
  @@index([gameId, trophyId, earnedAt])
  @@index([earnedAt])
}

enum TrophyType {
  bronze
  silver
  gold
  platinum
}

enum TrophyRareness {
  ultraRare
  veryRare
  rare
  common
}

model SystemConfig {
  id           Int     @id
  refreshToken String?
}
